# ============================================================================
# Elaraby Workforce — Complete Production Environment Configuration Template
# ============================================================================
# All values must be securely populated by the Enterprise Operations / IT Team.
# Do NOT commit active production secrets to version control.
# ============================================================================

# --- Core Runtime Configuration ---
NODE_ENV=production
PORT=3000
APP_URL=https://workforce.elarabygroup.com
CORS_ORIGIN=https://workforce.elarabygroup.com,https://admin.workforce.elarabygroup.com
APP_UPDATE_URL=https://app.elarabygroup.com

# --- Authoritative PostgreSQL Database ---
# Single authoritative relational database connection string.
# Multi-statement transactions, connection pooling, and SSL are automatically enforced.
DATABASE_URL=postgresql://USER:PASSWORD@postgres.internal.elarabygroup.com:5432/elaraby_workforce?sslmode=require
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# --- Distributed Redis Infrastructure ---
# Required for multi-instance distributed rate limiting, Redlock mutexes, BullMQ queues & Pub/Sub
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis.internal.elarabygroup.com:6379

# --- Authentication & Administrative Security ---
# Minimum 32 cryptographically random characters (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_cryptographically_secure_random_string_min_48_chars
ADMIN_USER=elaraby_sysadmin
ADMIN_PASS=replace_with_strong_unique_admin_password_min_16_chars

# --- Multi-Instance Object Storage (S3 / MinIO / Ceph / Cloudflare R2) ---
# Supported providers: s3, local
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://s3.me-south-1.amazonaws.com
S3_REGION=me-south-1
S3_BUCKET=elaraby-workforce-production-assets
S3_ACCESS_KEY_ID=AKIA_ENTERPRISE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=ENTERPRISE_SECRET_ACCESS_KEY_DO_NOT_SHARE
S3_FORCE_PATH_STYLE=false

# --- SMS Gateway Integration ---
# Supported providers: cequens, twilio, vodafone, mock (dev only)
SMS_PROVIDER=cequens
CEQUENS_API_KEY=cequens_production_api_key
CEQUENS_SENDER_ID=ELARABY

# Twilio fallback / alternate provider configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vodafone Egypt Corporate Gateway configuration
VODAFONE_API_KEY=
VODAFONE_ACCOUNT_ID=
VODAFONE_SENDER_NAME=ELARABY

# --- Firebase Push Notifications (FCM) ---
# Paste the JSON payload of the production Firebase service account, or provide individual keys
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=elaraby-workforce-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@elaraby-workforce-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"

# --- Enterprise ERP Integration (SAP / Oracle) ---
# Supported providers: sap, oracle, rest, mock (dev only)
ERP_PROVIDER=sap
SAP_BASE_URL=https://sap-gateway.internal.elarabygroup.com/odata/v2
SAP_CLIENT_ID=sap_oauth_client_id
SAP_CLIENT_SECRET=sap_oauth_client_secret
SAP_COMPANY_CODE=1000

# Oracle HCM integration parameters
ORACLE_BASE_URL=
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=

# --- Enterprise Observability & APM ---
SENTRY_DSN=
LOG_LEVEL=info
ENABLE_PROMETHEUS_METRICS=true
