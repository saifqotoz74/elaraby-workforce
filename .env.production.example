# ==========================================
# Elaraby Workforce - Production Environment Configuration
# ==========================================
NODE_ENV=production
PORT=8080

# Auth Secrets (MANDATORY: Minimum 32 random characters generated cryptographically)
JWT_SECRET=replace_with_64_char_hex_secret_openssl_rand_hex_32
ADMIN_USER=production_admin
ADMIN_PASS=replace_with_strong_production_admin_password_2026!

# Persistence
DATA_PATH=/var/data/elaraby-production
DATABASE_PATH=/var/data/elaraby-production
ALLOW_EPHEMERAL_STORAGE=false

# External Integrations
TWILIO_ACCOUNT_SID=AC_production_account_sid
TWILIO_AUTH_TOKEN=production_auth_token
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS Whitelist
CORS_ORIGIN=https://workforce.elarabygroup.com
APP_UPDATE_URL=https://workforce.elarabygroup.com/downloads
