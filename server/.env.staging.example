# ==========================================
# Elaraby Workforce - Staging Environment Configuration
# ==========================================
NODE_ENV=staging
PORT=3000

# Auth Secrets (Must be unique staging credentials, minimum 32 chars)
JWT_SECRET=staging_jwt_secret_elaraby_connect_2026_secure
ADMIN_USER=staging_admin
ADMIN_PASS=StagingSecure2026!

# Persistence
DATA_PATH=/var/data/elaraby-staging
ALLOW_EPHEMERAL_STORAGE=false

# External Integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS
CORS_ORIGIN=https://staging.elaraby-connect.internal
