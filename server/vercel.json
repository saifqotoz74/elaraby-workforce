{
  "version": 2,
  "env": {
    "ALLOW_JSON_IN_PROD": "true",
    "ALLOW_EPHEMERAL_STORAGE": "true"
  },
  "builds": [
    {
      "src": "admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "status": 301,
      "headers": { "Location": "/admin/" }
    },
    {
      "src": "/admin/",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
