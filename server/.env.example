# ============================================================================
# Elaraby Connect — Enterprise Server Environment Configuration Template
# Instructions: Copy this file to .env and supply environment-specific values.
# NEVER commit production credentials, tokens, or private keys to git.
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
SERVICE_NAME=elaraby-workforce-api

# Security & Authentication (MANDATORY IN PRODUCTION: min 48 characters)
JWT_SECRET=replace_with_cryptographically_secure_random_string_min_48_chars
ADMIN_USER=admin
ADMIN_PASS=replace_with_strong_unique_admin_password_min_16_chars
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Primary Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elaraby_workforce
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=false

# Distributed Cache, Pub/Sub & Queues (Redis 7)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
WORKER_CONCURRENCY=5

# SMS Gateway Provider (Options: mock, twilio, cequens, vodafone)
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=ELARABY

# Twilio Specific Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Cequens Egyptian SMS Gateway
CEQUENS_API_KEY=
CEQUENS_SENDER_ID=ELARABY

# Vodafone Egypt Bulk SMS
VODAFONE_SMS_USER=
VODAFONE_SMS_PASS=
VODAFONE_SMS_SENDER=ELARABY

# Firebase Cloud Messaging Push Notifications
PUSH_PROVIDER=mock
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Enterprise ERP Integration (Options: mock, sap, oracle, rest)
ERP_PROVIDER=mock
ERP_BASE_URL=
ERP_API_KEY=
ERP_BEARER_TOKEN=
SAP_ODATA_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
ORACLE_HCM_URL=
ORACLE_HCM_USER=
ORACLE_HCM_PASS=

# Observability & APM Monitoring
SENTRY_DSN=
METRICS_ENABLED=true
LOG_LEVEL=info
