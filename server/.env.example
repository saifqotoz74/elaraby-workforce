# Elaraby Connect Server — Environment Variables Example
# Duplicate as .env before starting the server.

NODE_ENV=production
PORT=3000

# Security (Required in production)
JWT_SECRET=replace_with_cryptographically_secure_random_string_min_48_chars
ADMIN_USER=admin
ADMIN_PASS=replace_with_strong_unique_admin_password_min_16_chars

# Storage
DATA_PATH=./data

# SMS OTP Provider (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+1xxxxxxxxxx

# FCM Push Notifications
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
