# ==============================================================================
# Workforce OS — Enterprise Production Environment Configuration Template
# Copy this file to .env or .env.production and configure production secrets.
# ==============================================================================

# Core Runtime Environment
NODE_ENV=production
PORT=3000

# Authoritative ACID Database (PostgreSQL 16+)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://workforce_user:STRONG_PRODUCTION_DB_PASSWORD@postgres:5432/workforce_os

# Cluster Cache, Rate Limiter & Message Broker (Redis 7+)
# Format: redis://:[password]@[host]:[port]
REDIS_URL=redis://:STRONG_PRODUCTION_REDIS_PASSWORD@redis:6379

# Cryptographic Authentication Secrets (Strictly enforced >= 32 characters in production)
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_STRING_2026
ADMIN_USER=admin
ADMIN_PASS=REPLACE_WITH_STRONG_ADMIN_PASSWORD_MIN_12_CHARS

# CORS Whitelist (Comma-separated origins for web admin & browser clients)
CORS_ORIGIN=https://admin.workforce-os.com,https://app.workforce-os.com

# Multi-Tenant & White-Label Domain Routing (Optional platform-level default)
DEFAULT_TENANT_ID=elaraby

# Enterprise Object Storage (local, s3, or minio)
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://s3.me-south-1.amazonaws.com
# S3_REGION=me-south-1
# S3_BUCKET=workforce-os-production-assets
# S3_ACCESS_KEY_ID=YOUR_AWS_OR_MINIO_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_AWS_OR_MINIO_SECRET_KEY
# S3_FORCE_PATH_STYLE=false

# Push Notifications (Firebase Cloud Messaging v1)
# FIREBASE_PROJECT_ID=workforce-os-prod
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@workforce-os-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SMS OTP Provider (mock, twilio, cequens, or vodafone)
SMS_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# CEQUENS_API_KEY=
# CEQUENS_SENDER_NAME=Workforce
