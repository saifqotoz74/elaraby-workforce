# ===============================================
# Elaraby Connect — Production Environment Template
# Copy this file to .env on the production server
# ===============================================

# Node environment
NODE_ENV=production
PORT=3000

# Security (CRITICAL: Set strong values)
# Generate a 64-char key: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# HR / Admin Dashboard Credentials
ADMIN_USER=admin
ADMIN_PASS=replace_with_strong_unique_password

# CORS Settings (Restrict to your domain or app scheme in production)
CORS_ORIGIN=https://workforce.elarabygroup.com

# Twilio SMS Service (Leave blank for dev mock code mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Firebase Admin SDK (Path to service account JSON for Push Notifications)
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/data/firebase-service-account.json
