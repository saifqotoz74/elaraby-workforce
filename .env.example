# ============================================================================
# Elaraby Connect — Root Enterprise Environment Variables Example
# ============================================================================

NODE_ENV=development
PORT=3000
API_BASE_URL=http://10.0.2.2:3000

# Backend Infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elaraby_workforce
REDIS_URL=redis://127.0.0.1:6379

# Security
JWT_SECRET=replace_with_cryptographically_secure_random_string_min_48_chars
ADMIN_USER=admin
ADMIN_PASS=replace_with_strong_unique_admin_password_min_16_chars

# External Integrations
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
ERP_PROVIDER=mock
SENTRY_DSN=
