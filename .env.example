# Elaraby Connect — Enterprise Production Environment Template
# Duplicate this file as .env and replace all placeholder secrets.
# NEVER commit real credentials to version control.

# Application Environment (production | development | test)
NODE_ENV=production
PORT=3000

# Cryptographic Secrets
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_cryptographically_secure_random_string_min_48_chars
ADMIN_USER=admin
ADMIN_PASS=replace_with_strong_unique_admin_password_min_16_chars

# Persistent Data Storage Directory (Must be a persistent volume in production)
DATA_PATH=./data
DATABASE_PATH=./data

# Twilio SMS Gateway (for real OTP delivery in Egypt)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1xxxxxxxxxx

# Firebase Cloud Messaging Service Account (for push notifications)
# Save service account credentials to: server/firebase-service-account.json
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# CORS & Base URLs
CORS_ORIGIN=https://connect.elaraby.com
APP_UPDATE_URL=https://connect.elaraby.com/download
